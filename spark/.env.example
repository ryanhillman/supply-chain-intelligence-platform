# Copy this file to .env. The defaults below run the whole stack on one machine
# with no GCP project (see local/README.md). Never commit .env — it is excluded
# by .gitignore.

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_GROUP_ID=scip-spark-bronze
# earliest reads the replayed history; ignored once a checkpoint exists.
KAFKA_STARTING_OFFSETS=earliest
KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.3

# ── Spark ─────────────────────────────────────────────────────────────────────
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=768m
SPARK_EXECUTOR_MEMORY=768m
IVY_CACHE=/opt/ivy2
TRIGGER_INTERVAL=30 seconds

# ── Project / Bigtable ────────────────────────────────────────────────────────
# The Bigtable client talks to the emulator from local/docker-compose.emulators.yml
# (same Docker network, so the service name resolves); the project id can be
# any string. Run `python local/init_emulator.py` once to create the table.
GCP_PROJECT_ID=local-scip
BIGTABLE_EMULATOR_HOST=bigtable-emulator:8086
BIGTABLE_INSTANCE_ID=scip-feature-store
BIGTABLE_TABLE_ID=inventory_features

# ── Storage paths ─────────────────────────────────────────────────────────────
# /opt/spark-app is the spark/ directory bind-mounted into the container, so
# these land in spark/data/ on the host (gitignored).
BRONZE_BASE_PATH=/opt/spark-app/data/bronze
SILVER_BASE_PATH=/opt/spark-app/data/silver
CHECKPOINT_BASE_PATH=/opt/spark-app/data/checkpoints/scip-spark-bronze
SILVER_CHECKPOINT_BASE_PATH=/opt/spark-app/data/checkpoints/scip-spark-silver
DLQ_BASE_PATH=/opt/spark-app/data/dlq

# ── GCP deployment (as run in June 2026) ─────────────────────────────────────
# To run against GCS and a real Bigtable instance instead: fill these in from
# `terraform output`, remove BIGTABLE_EMULATOR_HOST above, and start Spark with
# the key-mount override:
#   docker compose -f docker-compose.spark.yml -f docker-compose.gcp.yml up -d
# GCP_PROJECT_ID=your-gcp-project-id
# GCS_BUCKET_NAME=your-gcp-project-id-scip-lake
# GOOGLE_APPLICATION_CREDENTIALS=/opt/spark-app/keys/scip-spark-sa.json
# BRONZE_BASE_PATH=gs://your-gcp-project-id-scip-lake/bronze
# SILVER_BASE_PATH=gs://your-gcp-project-id-scip-lake/silver
# CHECKPOINT_BASE_PATH=gs://your-gcp-project-id-scip-lake/checkpoints/scip-spark-bronze
# SILVER_CHECKPOINT_BASE_PATH=gs://your-gcp-project-id-scip-lake/checkpoints/scip-spark-silver
# DLQ_BASE_PATH=gs://your-gcp-project-id-scip-lake/dlq
