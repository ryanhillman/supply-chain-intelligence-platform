# Copy this file to .env and fill in values from `terraform output` and your GCP project.
# Never commit .env — it is excluded by .gitignore.

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_GROUP_ID=scip-spark-bronze
KAFKA_STARTING_OFFSETS=latest
KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.3

# ── Spark ─────────────────────────────────────────────────────────────────────
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=768m
SPARK_EXECUTOR_MEMORY=768m
IVY_CACHE=/opt/ivy2
TRIGGER_INTERVAL=30 seconds

# ── GCP (fill in after `terraform apply`) ────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-gcp-project-id-scip-lake
GOOGLE_APPLICATION_CREDENTIALS=/opt/spark-app/keys/scip-spark-sa.json

# ── Storage paths (GCS) ───────────────────────────────────────────────────────
BRONZE_BASE_PATH=gs://your-gcp-project-id-scip-lake/bronze
SILVER_BASE_PATH=gs://your-gcp-project-id-scip-lake/silver
CHECKPOINT_BASE_PATH=gs://your-gcp-project-id-scip-lake/checkpoints/scip-spark-bronze
SILVER_CHECKPOINT_BASE_PATH=gs://your-gcp-project-id-scip-lake/checkpoints/scip-spark-silver
DLQ_BASE_PATH=gs://your-gcp-project-id-scip-lake/dlq


# ── Bigtable ──────────────────────────────────────────────────────────────────
BIGTABLE_INSTANCE_ID=scip-feature-store
BIGTABLE_TABLE_ID=inventory_features
